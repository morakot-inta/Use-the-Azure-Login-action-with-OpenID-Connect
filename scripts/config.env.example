# Copy to scripts/config.env and edit. config.env is git-ignored.

# Your GitHub repository in OWNER/REPO form (required)
GITHUB_REPO="your-user/oidc-lab"

# Azure settings
APP_NAME="gh-oidc-lab"
RESOURCE_GROUP="rg-oidc-lab"
LOCATION="southeastasia"
ENVIRONMENT_NAME="production"
ROLE="Contributor"

# Leave empty to use the subscription from `az account show`
SUBSCRIPTION_ID=""
